# Copy to local/robot_state/viewer.env and edit once on a new machine.
# Trusted Bash configuration, sourced by view_observation_robot_bag.sh.
# Project-local workspace; see tutorials/marvin_messages.md to rebuild.
# Leave empty if matching marvin_msgs is already sourced in your terminal.
omi_viewer_marvin_setup="$omi_viewer_root/local/ros2/marvin_msgs_ws/install/local_setup.bash"
# SDK defaults to the project-local archive. No need for the old diamond tree.
omi_viewer_sdk_root="$omi_viewer_root/local/vendor/daimon_tactile"
