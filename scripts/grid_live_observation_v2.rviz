# Generated by scripts/build_grid_live_v2_layout.py; camera/A/B rows and diagnostics.
Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.35
    Cell Size: 0.1
    Class: rviz_default_plugins/Grid
    Color: 100; 110; 120
    Enabled: true
    Name: Ground
    Plane Cell Count: 30
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description Source: Topic
    Description Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /omi/live_grid_v2/model/robot_description
    Enabled: true
    Name: Corrected Stand (display only)
    TF Prefix: ''
    Update Interval: 0
    Value: true
    Visual Enabled: true
  - Class: rviz_default_plugins/MarkerArray
    Name: EEF and L7
    Enabled: true
    Value: true
    Topic:
      Value: /omi/live_grid_v2/model_markers
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: External original
    Enabled: true
    Value: true
    Normalize Range: false
    Transport Hint: raw
    Topic:
      Value: /camera/camera/color/image_raw
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: External ROI 128
    Enabled: true
    Value: true
    Normalize Range: false
    Transport Hint: raw
    Topic:
      Value: /omi/live_grid_v2/panels/camera_roi
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: Wrist image (see topic)
    Enabled: true
    Value: true
    Normalize Range: false
    Transport Hint: raw
    Topic:
      Value: /omi/wrist/color/image_roi
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: A deformation
    Enabled: true
    Value: true
    Normalize Range: false
    Transport Hint: raw
    Topic:
      Value: /omi/live_grid_v2/panels/a_deformation
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: A shear
    Enabled: true
    Value: true
    Normalize Range: false
    Transport Hint: raw
    Topic:
      Value: /omi/live_grid_v2/panels/a_shear
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: A depth
    Enabled: true
    Value: true
    Normalize Range: false
    Transport Hint: raw
    Topic:
      Value: /omi/live_grid_v2/panels/a_depth
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: B deformation
    Enabled: true
    Value: true
    Normalize Range: false
    Transport Hint: raw
    Topic:
      Value: /omi/live_grid_v2/panels/b_deformation
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: B shear
    Enabled: true
    Value: true
    Normalize Range: false
    Transport Hint: raw
    Topic:
      Value: /omi/live_grid_v2/panels/b_shear
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: B depth
    Enabled: true
    Value: true
    Normalize Range: false
    Transport Hint: raw
    Topic:
      Value: /omi/live_grid_v2/panels/b_depth
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: Independent diagnostics
    Enabled: true
    Value: true
    Normalize Range: false
    Transport Hint: raw
    Topic:
      Value: /omi/live_grid_v2/diagnostics
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: EEF and control signals
    Enabled: true
    Value: true
    Normalize Range: false
    Transport Hint: raw
    Topic:
      Value: /omi/live_grid_v2/control_bar
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 30; 34; 40
    Fixed Frame: omi_replay_world
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.8
      Focal Point:
        X: 0.2
        Y: 0
        Z: 0.85
      Name: Live observations
      Pitch: 0.32
      Target Frame: omi_replay_world
      Yaw: 0.8
    Saved: null
Window Geometry:
  Width: 3000
  Height: 1800
  Hide Left Dock: true
  Hide Right Dock: false
  QMainWindow State: 
