Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.35
    Cell Size: 0.1
    Class: rviz_default_plugins/Grid
    Color: 100; 110; 120
    Enabled: true
    Name: Ground
    Plane Cell Count: 30
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description Source: Topic
    Description Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Enabled: false
    Name: Live Robot - Existing TF
    TF Prefix: ''
    Update Interval: 0
    Value: false
    Visual Enabled: true
  - Axes Length: 0.12
    Axes Radius: 0.008
    Class: rviz_default_plugins/Pose
    Enabled: true
    Name: Live EEF Pose
    Shape: Axes
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /tj/info/eef_left
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: Cameras Tactile and Robot State
    Normalize Range: false
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /omi/live_grid/dashboard
    Transport Hint: raw
    Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 34; 40
    Fixed Frame: base_link
    Frame Rate: 15
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.8
      Focal Point:
        X: 0.2
        Y: 0
        Z: 0.65
      Name: Live observations
      Pitch: 0.32
      Target Frame: base_link
      Yaw: 0.8
    Saved: null
Window Geometry:
  Height: 1150
  Hide Left Dock: false
  QMainWindow State: 
  Width: 2200
