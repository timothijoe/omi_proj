<?xml version="1.0" encoding="UTF-8" ?>
<!-- Opt-in same-host experiment. Not a remote-machine discovery profile. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>large_shm</transport_id>
        <type>SHM</type>
        <segment_size>67108864</segment_size>
        <maxMessageSize>8388608</maxMessageSize>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>local_udp</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
        <sendBufferSize>4194304</sendBufferSize>
        <receiveBufferSize>4194304</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="large_frames" is_default_profile="true">
      <rtps>
        <userTransports><transport_id>large_shm</transport_id><transport_id>local_udp</transport_id></userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
