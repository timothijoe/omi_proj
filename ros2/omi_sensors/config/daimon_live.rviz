Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: Wrist LIVE - host receive timestamp
    Normalize Range: false
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /omi/wrist/color/image_raw
    Transport Hint: raw
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: Tactile SDK dashboard - 15 Hz
    Normalize Range: false
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /omi/sdk/dashboard
    Transport Hint: raw
    Value: true
  Enabled: true
  Global Options:
    Background Color: 18; 20; 24
    Fixed Frame: map
    Frame Rate: 60
  Name: root
  Tools: []
  Value: true
Window Geometry:
  Height: 1060
  Width: 1650
